# Postgres connection string. On Railway use the PUBLIC connection URL
# (Variables tab of the Postgres service: DATABASE_PUBLIC_URL).
DATABASE_URL=postgresql://user:password@host:port/railway

# Long random secret for the /admin page. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-me

# Public results stay hidden until this many respondents have answered.
MIN_PUBLIC_N=5

# Set to "off" only for a local Postgres without SSL on a non-localhost host.
# PGSSL=off
